# ==============================================================================
# Financial Scam Research Framework - Git Ignore Configuration
# ==============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*-checkpoint.ipynb
.virtual_documents/

# --- Datasets & Data Artifacts ---
# Preserve directory tracking via .gitkeep while ignoring large data files
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

data/processed/*
!data/processed/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/splits/*
!data/splits/.gitkeep

# Catch-all data file formats
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.jsonl

# Allow research audit and evaluation tables in reports/
!reports/**/*.csv
!reports/*.csv

# --- Model Checkpoints & Weights ---
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.ckpt
*.joblib
checkpoints/
saved_models/
experiments/*/checkpoints/
experiments/*/models/

# --- Experiment Logs & Profiling ---
logs/
*.log
runs/
wandb/
lightning_logs/
.tensorboard/

# --- Test & Code Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- OS-specific Artifacts ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

